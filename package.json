{
  "name": "allegro-rest-client",
  "version": "2.0.0-next.0",
  "description": "Allegro REST API client: OAuth2 token lifecycle, fetch transport and injectable policies, for managing allegro.pl resources",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": "git@github.com:daksamit/allegro-rest-client.git",
  "author": "Dominik Aksamit <daksamit@daksamit.pl>",
  "keywords": [
    "allegro.pl",
    "allegro-rest-client"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \".build/test/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "spec:update": "node scripts/spec-update.mjs",
    "generate": "npm ci --prefix tools/generator --silent && node tools/generator/generate.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
